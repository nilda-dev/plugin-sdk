#!/bin/sh
# heavy-guard — refuse to start a heavy command (full test suite, build, analyzer) on a loaded Mac.
#
# CANONICAL COPY: nilda/core/scripts/heavy-guard. It is mirrored byte-for-byte in plugin-sdk/scripts and
# plugin-booking/scripts and mobile/scripts; change core's, then copy it. A test (scripts/heavy-guard_test.sh)
# lives next to each copy.
#
# Why: many chats run at once on one machine. On 2026-10-20 load reached 112 with swap at 10 GB and the
# machine hung; on another day a full disk wiped Docker volumes. A heavy job started on top of that makes it
# worse for every chat, so the cheap check runs first and the heavy job waits.
#
# Usage:  scripts/heavy-guard [--check-only]
#   exit 0  go ahead (the Go build cache may have been cleaned first)
#   exit 1  refused; the reason is printed on stderr. Wait and run again.
#   exit 2  bad usage
#
# Refuses when
#   (a) free disk on the current directory's volume is below HEAVY_GUARD_MIN_FREE_GB (default 20),
#   (b) the 1-minute load average is above HEAVY_GUARD_MAX_LOAD (default 12),
#   (c) (removed 2026-10-22, owner override of ART-15: several heavy jobs may run together while the load stays <= 12)
# Cleans the Go build cache (`go clean -cache` and NOTHING else — never docker, never volumes) when the cache
# directory is larger than HEAVY_GUARD_CACHE_MAX_GB (default 25). The cache regenerates; it just costs time.
# --check-only reports every finding and changes nothing (no clean).
#
# Every external tool is called by name so a test can put stubs first on PATH: df, uptime, ps, du, go.

min_free_gb=${HEAVY_GUARD_MIN_FREE_GB:-20}
max_load=${HEAVY_GUARD_MAX_LOAD:-12}
cache_max_gb=${HEAVY_GUARD_CACHE_MAX_GB:-25}
check_only=0

case "${1:-}" in
  "") ;;
  --check-only) check_only=1 ;;
  *) echo "usage: heavy-guard [--check-only]" >&2; exit 2 ;;
esac

fail=0
refuse() { echo "heavy-guard: REFUSED - $*" >&2; fail=1; }

# --- Go build cache: clean first, so the disk check below sees the space it frees ---------------------------
if command -v go >/dev/null 2>&1; then
  cache_dir=$(go env GOCACHE 2>/dev/null)
  if [ -n "$cache_dir" ] && [ -d "$cache_dir" ]; then
    cache_kb=$(du -sk "$cache_dir" 2>/dev/null | awk '{print $1}')
    cache_kb=${cache_kb:-0}
    if awk -v kb="$cache_kb" -v max="$cache_max_gb" 'BEGIN { exit !(kb / 1048576 > max) }'; then
      if [ "$check_only" = 1 ]; then
        echo "heavy-guard: Go build cache is $((cache_kb / 1048576)) GB (> ${cache_max_gb} GB); a normal run would clean it with 'go clean -cache'"
      else
        echo "heavy-guard: Go build cache is $((cache_kb / 1048576)) GB (> ${cache_max_gb} GB); running 'go clean -cache'"
        go clean -cache || refuse "'go clean -cache' failed"
      fi
    fi
  fi
fi

# --- (a) free disk ------------------------------------------------------------------------------------------
free_kb=$(df -Pk . 2>/dev/null | awk 'NR == 2 {print $4}')
if [ -z "$free_kb" ]; then
  refuse "cannot read free disk space (df gave nothing)"
elif awk -v kb="$free_kb" -v min="$min_free_gb" 'BEGIN { exit !(kb / 1048576 < min) }'; then
  refuse "free disk is $((free_kb / 1048576)) GB, below the ${min_free_gb} GB floor. Free space (a full disk once wiped Docker volumes), then run again"
fi

# --- (b) load average ---------------------------------------------------------------------------------------
# macOS prints "load averages: 2.73 4.52 4.76", Linux "load average: 0.10, 0.20, 0.30".
load1=$(uptime 2>/dev/null | sed -n 's/.*load averages\{0,1\}: *\([0-9][0-9.]*\).*/\1/p')
if [ -z "$load1" ]; then
  refuse "cannot read the load average (uptime gave nothing)"
elif awk -v l="$load1" -v max="$max_load" 'BEGIN { exit !(l + 0 > max + 0) }'; then
  refuse "1-minute load average is $load1, above $max_load. The machine is busy; wait and run again"
fi

# --- (c) other heavy jobs: NOT checked (owner override of ART-15, 2026-10-22: only load and disk decide) -----

if [ "$fail" = 0 ]; then
  echo "heavy-guard: ok (free disk $((free_kb / 1048576)) GB, load $load1)"
  exit 0
fi
exit 1
