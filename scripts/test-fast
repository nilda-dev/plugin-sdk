#!/bin/sh
# test-fast — the FAST test lane: only what a change can break, in minutes, before every push.
#
# CANONICAL COPY: nilda/core/scripts/test-fast. Mirrored in plugin-sdk/scripts, plugin-booking/scripts and
# commerce/scripts (the web lane below simply finds no web/admin there); mobile/scripts/test-fast is the Flutter
# variant with the same marker. Change core's, then copy it. Test: scripts/test-fast_test.sh.
#
# What it runs
#   1. the Go packages that CHANGED against origin/main (committed + uncommitted + untracked),
#   2. every package that depends on one of them, test imports included (reverse closure over `go list`),
#   3. the repo's always-run guard packages, one import-path suffix per line in scripts/test-fast.always,
#   4. `go vet` and `go test` on that list (-timeout 25m when internal/plugin or internal/pagebuilder is in it,
#      else 10m; scripts/test-fast.timeout overrides both, see below), WITH Go's test cache: a package whose files, dependencies and read environment did not change
#      since its last green run answers "(cached)" instead of running again (--no-cache runs everything),
#   5. when web/admin changed: `npx tsc --noEmit` and the vitest files related to the changed files.
# The FULL lane is `make test-full`: per milestone and nightly when the machine is idle, not per card — and it
# runs with -count=1, every test for real, which is what catches a test the cache would have answered for.
#
# WHY THE CACHE (owner, 2026-10-26). A change to a package most of Core imports (internal/settings) selects ~175
# packages, and with -count=1 a second run after a one-line admin fix ran all of them again: 50 minutes for
# nothing that had changed. Running the affected tests from cache before a push and the whole suite uncached
# on a schedule is how Google (TAP: presubmit, then periodic postsubmit), Azure's Test Impact Analysis and Nx
# (affected + cache) do it, and Go caches test results by default for this reason.
#
# Usage: scripts/test-fast [--list] [--committed-only] [--no-guard] [--no-cache] [--base REF]
#   --list            print the package list and stop (nothing runs, no guard)
#   --committed-only  ignore uncommitted and untracked files (what the pre-push hook uses)
#   --no-guard        skip scripts/heavy-guard (emergency only)
#   --no-cache        run every selected test for real (-count=1), as the full lane does
#   --base REF        compare against REF (default origin/main, or $TEST_FAST_BASE)
# A go.mod / go.sum change makes every package "changed".
# scripts/test-fast.timeout (optional, one line): a Go duration made of h, m and s parts, e.g. `50m` or `1h30m`,
# at most 2h. When present it is the `go test -timeout` of EVERY run in that repo (for a repo whose one package
# has a suite longer than the defaults, like commerce). Anything else in the file makes test-fast refuse (exit 2).
# Exit 0 = everything green; non-zero = something failed or the guard refused. Verify by exit code.
# THE MARKER. A green run (exit 0, not --list, not a guard refusal) records the commit it proved: it appends HEAD's
# sha to <git common dir>/nilda-way/fast-lane-ok (last 200 shas), which the Nilda Way push hook reads. The COMMON
# dir (`git rev-parse --git-common-dir`) is deliberate: a marker is about a COMMIT, a commit is the same in every
# worktree of a repo, and `.git` inside a worktree is a file — the common dir is the one place all worktrees
# share. It is written only when what ran IS that commit: if an uncommitted or untracked file reaches any
# package that ran (or web/admin when its lane ran), the run proved the dirty tree, so the script says
# "green on uncommitted changes: no marker for HEAD" and still exits 0.
# Needs the same environment as the full suite (Postgres for core: `make up`). GOWORK is off unless
# TEST_FAST_KEEP_GOWORK=1, so a lone clone is tested as a lone clone.

list_only=0; committed_only=0; use_guard=1; count_flag=
base=${TEST_FAST_BASE:-origin/main}
while [ $# -gt 0 ]; do
  case "$1" in
    --list) list_only=1 ;;
    --committed-only) committed_only=1 ;;
    --no-guard) use_guard=0 ;;
    --no-cache) count_flag=-count=1 ;;
    --base) shift; base=${1:?--base needs a ref} ;;
    *) echo "usage: test-fast [--list] [--committed-only] [--no-guard] [--no-cache] [--base REF]" >&2; exit 2 ;;
  esac
  shift
done

here=$(cd "$(dirname "$0")" && pwd)
timeout_override=
if [ -f "$here/test-fast.timeout" ]; then
  timeout_override=$(head -n 1 "$here/test-fast.timeout" | tr -d ' \t\r')
  secs=$(printf '%s\n' "$timeout_override" | awk '
    /^([0-9]+[hms])+$/ {
      s = $0; t = 0
      while (match(s, /^[0-9]+[hms]/)) {
        n = substr(s, 1, RLENGTH - 1) + 0; u = substr(s, RLENGTH, 1)
        t += n * (u == "h" ? 3600 : u == "m" ? 60 : 1); s = substr(s, RLENGTH + 1)
      }
      print t }')
  if [ -z "$secs" ] || [ "$secs" -le 0 ] || [ "$secs" -gt 7200 ]; then
    echo "test-fast: scripts/test-fast.timeout must hold one Go duration of h, m and s parts (e.g. 50m), above 0 and at most 2h; got '$timeout_override'" >&2
    exit 2
  fi
fi
root=$(git rev-parse --show-toplevel) || exit 2
cd "$root" || exit 2
start=$(date +%s)
[ "${TEST_FAST_KEEP_GOWORK:-0}" = 1 ] || export GOWORK=off

git rev-parse --verify -q "$base" >/dev/null || { echo "test-fast: base '$base' not found; run: git fetch" >&2; exit 2; }

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
changed="$tmp/changed"
{
  git diff --name-only "$base"...HEAD
  if [ "$committed_only" = 0 ]; then
    git diff --name-only HEAD
    git ls-files --others --exclude-standard
  fi
} | sort -u > "$changed"
nfiles=$(wc -l < "$changed" | tr -d ' ')

# select_pkgs CHANGED_FILE_LIST: prints "changed|dependent|guard <import path>" lines for those files.
select_pkgs() {
  awk -v root="$root" -v always="$always" '
    BEGIN { FS = "|"; na = split(always, al, " ") }
    FNR == NR { ip = $1; edges[ip] = $3; pkgdir[$2] = ip; order[++n] = ip; next }
    {
      f = $0
      if (f == "go.mod" || f == "go.sum") { all = 1; next }
      if (f ~ /\.md$/) next
      d = root "/" f; sub("/[^/]*$", "", d)
      while (!(d in pkgdir) && length(d) > length(root)) sub("/[^/]*$", "", d)
      # A test file or a testdata fixture is only read by the tests of its OWN package: nothing that imports the
      # package can see it, so it does not propagate to dependents. Everything else (code, embedded files) does.
      # Docs, scripts and tooling folders do not belong to the ROOT package (the walk-up would land there);
      # a Go package of their own (scripts/metrics/) is still found above, before the walk reaches the root.
      if (d == root && f ~ /^(docs|scripts|\.github|\.claude|mobile)\//) next
      if (d in pkgdir) { if (f ~ /_test\.go$/ || f ~ /(^|\/)testdata\//) own[pkgdir[d]] = 1; else changed[pkgdir[d]] = 1 }
    }
    END {
      for (i = 1; i <= n; i++) if (all) changed[order[i]] = 1
      for (p in changed) hit[p] = 1
      do {
        grew = 0
        for (i = 1; i <= n; i++) {
          p = order[i]
          if (p in hit) continue
          m = split(edges[p], e, " ")
          for (j = 1; j <= m; j++) if (e[j] in hit) { hit[p] = 1; dep[p] = 1; grew = 1; break }
        }
      } while (grew)
      anyhit = 0
      for (p in hit) anyhit = 1
      for (p in own) anyhit = 1
      for (i = 1; i <= n; i++) {
        p = order[i]
        if (p in changed || p in own) print "changed " p
        else if (p in dep) print "dependent " p
        else if (anyhit) {
          for (j = 1; j <= na; j++) { s = al[j]; if (substr(p, length(p) - length(s) + 1) == s) { print "guard " p; break } }
        }
      }
    }' "$tmp/graph" "$1"
}

# --- Go: changed packages + reverse dependencies ---------------------------------------------------------
gopkgs=""
if [ -f go.mod ]; then
  go list -e -f '{{.ImportPath}}|{{.Dir}}|{{join .Deps " "}} {{join .TestImports " "}} {{join .XTestImports " "}}' ./... > "$tmp/graph" 2>"$tmp/golist.err" \
    || { echo "test-fast: go list failed:" >&2; cat "$tmp/golist.err" >&2; exit 2; }
  always=""
  [ -f "$here/test-fast.always" ] && always=$(grep -v '^#' "$here/test-fast.always" | grep -v '^$' | tr '\n' ' ')
  select_pkgs "$changed" > "$tmp/pkgs"
  gopkgs=$(awk '{print $2}' "$tmp/pkgs" | tr '\n' ' ')
fi

# --- web: changed admin files ----------------------------------------------------------------------------
webfiles=$(grep -E '^web/admin/(src|index\.html|package\.json|tsconfig|vite|vitest)' "$changed" | grep -v '^web/admin/dist/')
webrel=""
for f in $webfiles; do [ -f "$f" ] && webrel="$webrel ${f#web/admin/}"; done

echo "test-fast: base=$base, $nfiles changed file(s) (committed-only=$committed_only)"
if [ -n "$gopkgs" ]; then
  awk '{ printf "  go %-9s %s\n", $1, $2 }' "$tmp/pkgs"
else
  echo "  go: no package affected"
fi
[ -n "$webfiles" ] && echo "  web: tsc + vitest related to:$webrel"
[ "$list_only" = 1 ] && exit 0

if [ "$use_guard" = 1 ] && [ -n "$gopkgs$webfiles" ]; then
  "$here/heavy-guard" || { echo "test-fast: heavy-guard refused; wait and run again" >&2; exit 3; }
fi

rc=0
if [ -n "$gopkgs" ]; then
  timeout=10m
  case " $gopkgs " in *internal/plugin\ *|*internal/pagebuilder\ *) timeout=25m ;; esac
  [ -n "$timeout_override" ] && timeout=$timeout_override
  echo "test-fast: go vet ..."
  # shellcheck disable=SC2086
  go vet $gopkgs || { echo "test-fast: go vet FAILED" >&2; rc=1; }
  echo "test-fast: go test ${count_flag:+$count_flag }-timeout $timeout ..."
  # shellcheck disable=SC2086
  go test $count_flag -timeout "$timeout" $gopkgs || { echo "test-fast: go test FAILED" >&2; rc=1; }
fi

if [ -n "$webfiles" ]; then
  if [ ! -d web/admin/node_modules ]; then
    echo "test-fast: web/admin/node_modules is missing; run: (cd web/admin && npm ci)" >&2; rc=1
  else
    echo "test-fast: tsc --noEmit ..."
    (cd web/admin && npx tsc --noEmit) || { echo "test-fast: tsc FAILED" >&2; rc=1; }
    if [ -n "$webrel" ]; then
      echo "test-fast: vitest related ..."
      # shellcheck disable=SC2086
      (cd web/admin && npx vitest related --run $webrel) || { echo "test-fast: vitest FAILED" >&2; rc=1; }
    fi
  fi
fi

# --- the marker: record the commit this green run proved -------------------------------------------------
# Only a green run gets here with rc=0. The marker is written when no uncommitted/untracked file reaches a
# package that ran (the dirty selection, dependents included, is intersected with the run set) or the web lane.
record_green() {
  { git diff --name-only HEAD; git ls-files --others --exclude-standard; } | sort -u > "$tmp/dirty"
  dirtyhit=0
  if [ -s "$tmp/dirty" ]; then
    if [ -n "$gopkgs" ] && [ -f go.mod ]; then
      select_pkgs "$tmp/dirty" | awk '$1 != "guard" { print $2 }' > "$tmp/dirtypkgs"
      for p in $gopkgs; do grep -qx "$p" "$tmp/dirtypkgs" && dirtyhit=1; done
    fi
    if [ -n "$webfiles" ] && grep -E '^web/admin/(src|index\.html|package\.json|tsconfig|vite|vitest)' "$tmp/dirty" | grep -qv '^web/admin/dist/'; then
      dirtyhit=1
    fi
  fi
  if [ "$dirtyhit" = 1 ]; then
    echo "test-fast: green on uncommitted changes: no marker for HEAD"
    return 0
  fi
  sha=$(git rev-parse HEAD) || return 0
  common=$(git rev-parse --git-common-dir) && common=$(cd "$common" && pwd) || return 0
  mkdir -p "$common/nilda-way" || return 0
  marker="$common/nilda-way/fast-lane-ok"
  { [ -f "$marker" ] && grep -vx "$sha" "$marker"; echo "$sha"; } | tail -n 200 > "$marker.$$" && mv "$marker.$$" "$marker"
  echo "test-fast: marker written for $(printf '%.7s' "$sha") in $marker"
}

[ "$rc" = 0 ] && record_green
echo "test-fast: elapsed $(( $(date +%s) - start ))s, exit $rc"
exit $rc
