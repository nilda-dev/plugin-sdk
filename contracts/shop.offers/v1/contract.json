{
  "name": "shop.offers/v1",
  "description": "Offers at the cart, the checkout (an order bump) and after the purchase: which to show for a basket, and which offers already on basket lines still stand, for the shop to price them through its own discounts (OFFERS.md).",
  "methods": [
    {
      "name": "offers.for",
      "answered_by": "provider",
      "description": "The offers to show at one stage for one basket or the order just paid, the first first.",
      "retry_class": "failure",
      "fallback": "skip",
      "idempotent": true,
      "agent": "none",
      "agent_reason": "an offer is shown to a shopper on the shop's pages; the owner sets and reads offers through the offers plugin's own abilities",
      "input": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "lines": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string"
                },
                "qty": {
                  "type": "integer"
                },
                "unit_price_minor": {
                  "type": "integer"
                },
                "offer_id": {
                  "type": "string"
                }
              },
              "required": [
                "sku",
                "qty",
                "unit_price_minor"
              ]
            }
          },
          "currency": {
            "type": "string"
          },
          "subtotal_minor": {
            "type": "integer"
          },
          "locale": {
            "type": "string"
          },
          "order_id": {
            "type": "string"
          }
        },
        "required": [
          "stage",
          "lines",
          "currency",
          "subtotal_minor"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "offers": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "sku": {
                  "type": "string"
                },
                "headline": {
                  "type": "string"
                },
                "percent_off": {
                  "type": "integer"
                },
                "max_units": {
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "sku",
                "percent_off",
                "max_units"
              ]
            }
          }
        },
        "required": [
          "offers"
        ]
      }
    },
    {
      "name": "offers.confirm",
      "answered_by": "provider",
      "description": "Which offers on the basket's lines still stand, with their discount now.",
      "retry_class": "failure",
      "fallback": "skip",
      "idempotent": true,
      "agent": "none",
      "agent_reason": "an offer is shown to a shopper on the shop's pages; the owner sets and reads offers through the offers plugin's own abilities",
      "input": {
        "type": "object",
        "properties": {
          "lines": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string"
                },
                "qty": {
                  "type": "integer"
                },
                "unit_price_minor": {
                  "type": "integer"
                },
                "offer_id": {
                  "type": "string"
                }
              },
              "required": [
                "sku",
                "qty",
                "unit_price_minor"
              ]
            }
          },
          "currency": {
            "type": "string"
          },
          "subtotal_minor": {
            "type": "integer"
          }
        },
        "required": [
          "lines",
          "currency",
          "subtotal_minor"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "sku": {
                  "type": "string"
                },
                "headline": {
                  "type": "string"
                },
                "percent_off": {
                  "type": "integer"
                },
                "max_units": {
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "sku",
                "percent_off",
                "max_units"
              ]
            }
          }
        },
        "required": [
          "accepted"
        ]
      }
    }
  ]
}
