{
  "name": "shop.events/v1",
  "description": "The shop's order events — placed, paid, cancelled, refunded line by line, fulfilled — each with the shop's event_id and sequence, the order's money net of tax in its currency, and the visitor's consent copied when the order was placed; and the read a subscriber catches up with, after the last sequence it handled (SHOP_EVENTS.md).",
  "methods": [
    {
      "name": "events.read",
      "answered_by": "provider",
      "description": "EXPERIMENTAL. The shop's order events after a sequence, oldest first, at most 100 a page; more says another page follows. Each event is the same data its delivery carried.",
      "retry_class": "failure",
      "fallback": "block",
      "idempotent": true,
      "agent": "none",
      "agent_reason": "the owner reads orders, refunds and shipments through the shop's own abilities (list_orders, get_order); this is how a measuring plugin catches up on what it was told",
      "input": {
        "type": "object",
        "properties": {
          "after_sequence": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "after_sequence"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "events": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "event_id": {
                  "type": "string"
                },
                "sequence": {
                  "type": "integer"
                },
                "type": {
                  "type": "string"
                },
                "order_id": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                },
                "occurred_at": {
                  "type": "string"
                },
                "currency": {
                  "type": "string"
                },
                "net_minor": {
                  "type": "integer"
                },
                "shipping_minor": {
                  "type": "integer"
                },
                "tax_minor": {
                  "type": "integer"
                },
                "total_minor": {
                  "type": "integer"
                },
                "refunded_minor": {
                  "type": "integer"
                },
                "refund_minor": {
                  "type": "integer"
                },
                "fulfillment_id": {
                  "type": "string"
                },
                "lines": {
                  "type": [
                    "null",
                    "array"
                  ],
                  "items": {
                    "type": "object",
                    "properties": {
                      "sku": {
                        "type": "string"
                      },
                      "product_sku": {
                        "type": "string"
                      },
                      "quantity": {
                        "type": "integer"
                      },
                      "quantity_refunded": {
                        "type": "integer"
                      },
                      "quantity_cancelled": {
                        "type": "integer"
                      },
                      "quantity_fulfilled": {
                        "type": "integer"
                      },
                      "net_minor": {
                        "type": "integer"
                      },
                      "tax_minor": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "sku",
                      "quantity",
                      "net_minor",
                      "tax_minor"
                    ]
                  }
                },
                "consent": {
                  "type": "object",
                  "properties": {
                    "ad_storage": {
                      "type": "string"
                    },
                    "ad_user_data": {
                      "type": "string"
                    },
                    "ad_personalization": {
                      "type": "string"
                    },
                    "analytics_storage": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    },
                    "recorded_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ad_storage",
                    "ad_user_data",
                    "ad_personalization",
                    "analytics_storage",
                    "source",
                    "recorded_at"
                  ]
                }
              },
              "required": [
                "event_id",
                "sequence",
                "type",
                "order_id",
                "ref",
                "occurred_at",
                "currency",
                "net_minor",
                "shipping_minor",
                "tax_minor",
                "total_minor",
                "refunded_minor",
                "lines",
                "consent"
              ]
            }
          },
          "more": {
            "type": "boolean"
          }
        },
        "required": [
          "events",
          "more"
        ]
      }
    }
  ],
  "status": "experimental"
}
