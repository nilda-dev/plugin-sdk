            ],
            "properties": {
              "record_id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "customer_user_id": {
                "type": "string"
              },
              "amount_minor": {
                "type": "integer"
              },
              "percent": {
                "type": "integer"
              },
              "currency": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "order_id": {
                "type": "string"
              },
              "expires_at": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "issued_at": {
