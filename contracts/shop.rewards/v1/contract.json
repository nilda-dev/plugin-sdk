            ]
          },
          "minimum_subtotal_minor": {
            "type": "integer"
          }
        },
        "required": [
          "customer_user_id",
          "kind",
          "value",
          "title"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string"
          },
          "already": {
            "type": "boolean"
          },
          "refused": {
            "type": "string"
          },
          "balance_minor": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "record_id",
          "already"
        ]
      },
      "write": {
        "record": "reward_discount",
        "undo": "discount.undo",
        "emits": "ecommerce.reward_discount.issued"
      }
    },
    {
      "name": "discount.undo",
      "answered_by": "provider",
      "description": "EXPERIMENTAL. Take back a code this plugin issued: it goes to the site's recycle bin. Refused used once an order used it.",
      "retry_class": "answer",
      "fallback": "block",
      "idempotent": true,
      "agent": "none",
      "agent_reason": "the owner reads and takes back store credit and discount codes through the shop's own abilities (customer_store_credit, list_discounts, delete_discount), each saying which plugin issued it; this is how the plugin that owns the points spends them",
      "input": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string"
          }
        },
        "required": [
          "record_id"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string"
          },
          "already": {
            "type": "boolean"
          },
          "refused": {
            "type": "string"
          },
          "balance_minor": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "record_id",
          "already"
        ]
      },
      "write": {
        "record": "reward_discount",
        "emits": "ecommerce.reward_discount.undone"
      }
    },
    {
      "name": "issued.get",
      "answered_by": "provider",
      "description": "EXPERIMENTAL. What one record this plugin issued is now: open, used (and by which order), expired or undone.",
      "retry_class": "failure",
      "fallback": "block",
      "idempotent": true,
      "agent": "none",
      "agent_reason": "the owner reads and takes back store credit and discount codes through the shop's own abilities (customer_store_credit, list_discounts, delete_discount), each saying which plugin issued it; this is how the plugin that owns the points spends them",
      "input": {
