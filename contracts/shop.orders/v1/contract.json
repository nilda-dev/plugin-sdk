{
  "name": "shop.orders/v1",
  "description": "The shop's orders, read by a plugin that delivers what an order bought — a licence key, a code, a ticket: the lines, the buyer's email and language, and whether it is paid (ORDERS.md).",
  "methods": [
    {
      "name": "order.get",
      "answered_by": "provider",
      "description": "One order by its id: reference, status, buyer email and language, currency, and each line's SKU, title, quantity and quantity refunded.",
      "retry_class": "failure",
      "fallback": "block",
      "idempotent": true,
      "agent": "none",
      "agent_reason": "the owner reads orders through the shop's own abilities (list_orders, get_order); this is how a delivering plugin reads the order it was told was paid",
      "input": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          }
        },
        "required": [
          "order_id"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean"
          },
          "order": {
            "type": [
              "null",
              "object"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "paid": {
                "type": "boolean"
              },
              "email": {
                "type": "string"
              },
              "locale": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "total_minor": {
                "type": "integer"
              },
              "placed_at": {
                "type": "string"
              },
              "lines": {
                "type": [
                  "null",
                  "array"
                ],
                "items": {
                  "type": "object",
                  "properties": {
                    "sku": {
                      "type": "string"
                    },
                    "product_sku": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "quantity": {
                      "type": "integer"
                    },
                    "quantity_refunded": {
                      "type": "integer"
                    },
                    "unit_price_minor": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "sku",
                    "title",
                    "quantity",
                    "unit_price_minor"
                  ]
                }
              }
            },
            "required": [
              "id",
              "ref",
              "status",
              "paid",
              "email",
              "locale",
              "currency",
              "total_minor",
              "placed_at",
              "lines"
            ]
          }
        },
        "required": [
          "found"
        ]
      }
    }
  ]
}
