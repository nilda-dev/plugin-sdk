    {
      "name": "describe",
      "answered_by": "provider",
      "description": "The shop as an adapter announces it: name, address, currency, its legal pages, and the delegated payment credentials it can charge.",
      "retry_class": "failure",
      "fallback": "block",
      "idempotent": true,
      "agent": "none",
      "agent_reason": "a checkout is a buyer's: a visitor's agent reaches it through the shop's visitor tools (create_cart, quote, place_order), the owner through the shop's own abilities (list_saved_checkouts); this is how a protocol adapter drives it",
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "name": {
