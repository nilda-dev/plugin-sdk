{
  "name": "site.reader/v1",
  "description": "A plugin that READS another platform's site — a WordPress export file or a live WordPress, later Shopify, Wix, Squarespace — and hands Core's importer a neutral description of it (package siteimport, Core's snapshot version 4) in pieces; Core checks every piece, writes the site as drafts and keeps the report, the publish act and the undo (SITE_READER.md).",
  "methods": [
    {
      "name": "sources",
      "answered_by": "provider",
      "description": "The platforms this plugin reads and, for each, the fields the owner fills in (a file, an address, an application password, a choice) as a description Core draws on its Importer screen.",
      "retry_class": "failure",
      "fallback": "block",
      "idempotent": true,
      "agent": "none",
      "agent_reason": "the owner starts a read from Core's Importer screen and the assistant's import tools drive the same job; this is how Core asks the reader plugin, and no other plugin or tool may start a read with an owner's password",
      "input": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string"
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "snapshot_version": {
            "type": "integer"
          },
          "sources": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "platform": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "fields": {
                  "type": [
                    "null",
                    "array"
                  ],
                  "items": {
                    "type": "object",
